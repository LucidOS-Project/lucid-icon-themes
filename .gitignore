# Backups left beside a file being edited by hand. They are a local safety net,
# not a second copy of the theme for everyone who clones this.
*.bak

# macOS metadata. These assets have passed through a Mac and a browser
# download, which leaves an AppleDouble sidecar beside every file and a
# .DS_Store in every directory. They are inert on Linux, they are not images,
# and debian/install copies whole directories -- so left in place they ship in
# the .deb.
._*
.DS_Store

# dpkg-buildpackage leavings. The staging root under debian/ is a second copy
# of the whole theme -- 120 MB of it -- and the rest is generated per build.
/debian/.debhelper/
# Every binary package's staging root, not just the one that existed when
# this line was written -- naming them individually is how a second
# package's staging directory got committed.
/debian/lucidos-icon-themes/
/debian/lucid-everything-icon-theme/
/debian/debhelper-build-stamp
/debian/files
/debian/*.substvars
/debian/*.debhelper
